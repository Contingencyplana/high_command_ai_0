{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "civilian-ledger@1.0",
  "title": "War Office Civilian Ledger",
  "type": "object",
  "required": ["schema", "civ_id", "guild", "house", "cell", "status", "aspect", "paired_workspace", "missions", "slots_total", "slots_filled", "ledger_trace"],
  "properties": {
    "schema": {"const": "civilian-ledger@1.0"},
    "civ_id": {"type": "string", "pattern": "^civ-[0-9a-f]{6}$"},
    "guild": {"type": "string", "pattern": "^guild_[0-9a-f]{2}$"},
    "house": {"type": "string", "pattern": "^house_[0-9a-f]{2}$"},
    "cell": {"type": "string", "pattern": "^cell_[0-9a-f]{1}$"},
    "status": {"enum": ["active", "resting", "honored"]},
    "aspect": {"enum": ["love", "light", "safety", "sanity", "play"]},
    "paired_workspace": {"type": "string"},
    "missions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["front", "milestone", "goal"],
        "properties": {
          "front": {"type": "string"},
          "milestone": {"type": "string"},
          "goal": {"type": "string"},
          "ledger_trace": {"type": "string"}
        }
      }
    },
    "slots_total": {"type": "integer", "const": 4096},
    "slots_filled": {"type": "integer", "minimum": 0, "maximum": 4096},
    "ledger_trace": {"type": "string"}
  }
}
